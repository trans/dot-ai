#!/bin/sh
# dot-ai: the command for a project's .ai/. Its `mail` commands send, file
# and drop messages, and, as the machine's local mail carrier, deliver .ai/
# mail between the projects on this machine, keep their topics, and tell
# agents when mail or posts are waiting. It follows the Mail spec in the
# dot.ai repository (spec/mail.md); notes/dot-ai-mail.md there is its design.
# Where another program carries the machine's mail (git config ai.carrier),
# the carrier's work is handed to it.
#
# Needs only POSIX sh and tools: find, sed, awk, date, mv, git (for ai.path
# and ai.carrier), and sha256sum, shasum or openssl.

LC_ALL=C
export LC_ALL
VERSION=0.5.0
MAX_DEPTH=4 # how far below a search root a project may sit
TAB=$(printf '\t')

usage() {
  cat <<'EOF'
dot-ai: a project's .ai/ (its notes, its mail, the machine's topics)

  dot-ai mail send ADDRESS TOPIC [--re ID] [DIR] <MESSAGE
                         send MESSAGE (standard input) to ADDRESS, @handle or
                         '#topic', about TOPIC (a few words); --re: the id of
                         the message it answers, or #topic:N
  dot-ai mail draft ADDRESS TOPIC [--re ID] [--why WHY] [--by WHO] [DIR] <MESSAGE
                         the same, kept in .ai/mail/drafts/ instead: --why it
                         waits on the user, or --by the helper who wrote it
  dot-ai mail send NAME  send a draft (once the user approves, or the lead
                         has reviewed it)
  dot-ai mail check [DIR]      list the inbox, oldest first (exit 1 when empty)
  dot-ai mail done NAME...     file messages dealt with under .ai/mail/received/
  dot-ai mail rm NAME...       remove messages from the inbox (or drafts)
                               without filing them
  dot-ai mail deliver [DIR]    deliver the outbox
  dot-ai mail topic [TOPIC DESCRIPTION]
                               make a topic, or list them all
  dot-ai mail read TOPIC [--after N] [DIR]
                               the posts after this project's place in TOPIC,
                               or after post N, and move the place on
  dot-ai mail find [ADDRESS]   where ADDRESS's project is, or every project found
  dot-ai hook EVENT [--agent claude|codex]
                               what the session hooks run: session-start, stop,
                               prompt, session-end (reads the hook's JSON on
                               stdin)
  dot-ai hooks                 print the hook entries for Claude Code and Codex,
                               for use without the dot-ai plugin
  dot-ai version

The project is the one at or above DIR (by default, here). NAME is a
message's file name, its path, or its id. A topic is written '#name'
(quoted: the shell takes a bare # as a comment) or just name.
EOF
}

warn() { printf 'dot-ai: %s\n' "$*" >&2; }
die() {
  warn "$*"
  exit 1
}

TMP=
LOCK=
cleanup() {
  [ -n "$LOCK" ] && rmdir "$LOCK" 2>/dev/null
  [ -n "$TMP" ] && rm -rf "$TMP"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
tmpdir() {
  [ -n "$TMP" ] || TMP=$(mktemp -d "${TMPDIR:-/tmp}/dot-ai.XXXXXX") || die "can't make a temporary directory"
}

# Takes the lock LOCKDIR, a directory, so making it is atomic; one older
# than 2 minutes is a crashed run's, and is cleared
lock() {
  mkdir "$1" 2>/dev/null && return 0
  [ -n "$(find "$1" -prune -mmin +2 2>/dev/null)" ] && rmdir "$1" 2>/dev/null
  mkdir "$1" 2>/dev/null
}

# This script's path, for telling agents how to run it
self_path() {
  case $0 in
    /*) printf '%s\n' "$0" ;;
    *) printf '%s/%s\n' "$(cd "$(dirname "$0")" && pwd -P)" "$(basename "$0")" ;;
  esac
}

# The machine's carrier, git config's ai.carrier (spec/mail.md: The
# carrier). dot-ai is `local`, the default.
carrier() {
  c=$(git config --get ai.carrier 2>/dev/null)
  printf '%s\n' "${c:-local}"
}
# Under another carrier, hands it the carrier's work, mail command CMD with
# its arguments (`arcana mail CMD ...` for arcana); returns where dot-ai is
# the carrier
hand_off() {
  c=$(carrier)
  case $c in
    local) return 0 ;;
    arcana)
      command -v arcana >/dev/null 2>&1 ||
        die "this machine's carrier is arcana (git config ai.carrier), but there's no arcana command"
      exec arcana mail "$@"
      ;;
    *) die "this machine's carrier is $c (git config ai.carrier), which dot-ai can't hand mail to" ;;
  esac
}

# -- Projects and addresses ---------------------------------------------------

# The project at or above DIR: the nearest directory, DIR included, holding .ai/
project_root() {
  d=$(cd "$1" 2>/dev/null && pwd -P) || return 1
  while :; do
    if [ -d "$d/.ai" ]; then
      printf '%s\n' "$d"
      return 0
    fi
    [ "$d" = / ] && return 1
    d=$(dirname "$d")
  done
}

# A directory's name made into a handle (spec/identity.md: The project)
fold_name() {
  printf '%s\n' "$1" | tr 'A-Z' 'a-z' |
    sed -e 's/[^a-z0-9-][^a-z0-9-]*/-/g' -e 's/^-*//' -e 's/-*$//' \
      -e 's/^[^a-z]/agent-&/' -e 's/^$/agent/'
}

# A project's handle: the top-level `handle:` line of its config, plain or
# quoted, with or without the @; without one, its directory's name, folded.
# Fails when the line is there but isn't a handle.
handle_of() {
  v=
  if [ -f "$1/.ai/config.yml" ]; then
    v=$(sed -n 's/^handle:[[:space:]]*//p' "$1/.ai/config.yml" | head -n 1 | tr -d '\r' |
      sed -e 's/[[:space:]]#.*$//' -e 's/[[:space:]]*$//')
  fi
  case $v in
    \"*\") v=${v#\"}; v=${v%\"} ;;
    \'*\') v=${v#\'}; v=${v%\'} ;;
  esac
  v=${v#@}
  if [ -z "$v" ]; then
    fold_name "$(basename "$1")"
    return 0
  fi
  case $v in
    [a-z]*) case $v in *[!a-z0-9-]*) return 1 ;; esac ;;
    *) return 1 ;;
  esac
  printf '%s\n' "$v"
}

# Where to look for projects: ai.path, else the outermost project enclosing
# DIR's project, else that project's parent directory
search_roots() {
  roots=$(git config --get-all --type=path ai.path 2>/dev/null)
  if [ -n "$roots" ]; then
    printf '%s\n' "$roots"
    return
  fi
  outer=
  d=$(dirname "$1")
  while :; do
    [ -d "$d/.ai" ] && outer=$d
    [ "$d" = / ] && break
    d=$(dirname "$d")
  done
  printf '%s\n' "${outer:-$(dirname "$1")}"
}

# Every project under the search roots, as "@handle<TAB>dir" lines in $MAP, or
# "!<TAB>dir" for a config whose handle can't be read. Symbolic links aren't
# followed, and hidden directories and node_modules/ aren't searched.
MAP=
scan() {
  [ -n "$MAP" ] && return
  tmpdir
  MAP=$TMP/map
  search_roots "$1" | while IFS= read -r root; do
    [ -n "$root" ] || continue
    if ! real=$(cd "$root" 2>/dev/null && pwd -P); then
      warn "ai.path: no such directory: $root"
      continue
    fi
    find "$real" -mindepth 1 -maxdepth $((MAX_DEPTH + 1)) \
      \( -name .ai -type d -print -prune \) -o \( -name '.*' -o -name node_modules \) -prune 2>/dev/null
  done | sed 's,/\.ai$,,' | sort -u | while IFS= read -r dir; do
    if h=$(handle_of "$dir"); then
      printf '@%s\t%s\n' "$h" "$dir"
    else
      printf '!\t%s\n' "$dir"
    fi
  done >"$MAP"
}

# The project with ADDRESS: prints its directory, or fails printing why
lookup() {
  found=$(awk -F '\t' -v a="$1" '$1 == a { print $2 }' "$MAP")
  case $found in
    '') printf 'no project on this machine has the address %s\n' "$1" ;;
    *"
"*) printf 'two projects have the address %s: %s\n' "$1" \
      "$(printf '%s\n' "$found" | awk 'NR > 1 { printf " and " } { printf "%s", $0 }')" ;;
    *)
      printf '%s\n' "$found"
      return 0
      ;;
  esac
  return 1
}

# -- Topics --------------------------------------------------------------------

# Whether NAME (without the #) is a topic's: names made like handles, joined
# by `.` (spec/mail.md: Addresses)
topic_ok() {
  printf '%s\n' "$1" | grep -qx -e '[a-z][a-z0-9-]*\(\.[a-z][a-z0-9-]*\)*'
}

# Where this machine's topics are kept: .ai/topics/ of the topic home, the
# first ai.path directory, else the outermost project at or above ROOT.
# Prints it, or why there's none.
topic_home() {
  first=$(git config --get-all --type=path ai.path 2>/dev/null | head -n 1)
  if [ -n "$first" ]; then
    if ! d=$(cd "$first" 2>/dev/null && pwd -P); then
      printf 'ai.path: no such directory: %s\n' "$first"
      return 1
    fi
  else
    d=$1 x=$1
    while [ "$x" != / ]; do
      x=$(dirname "$x")
      [ -d "$x/.ai" ] && d=$x
    done
  fi
  if [ ! -d "$d/.ai" ]; then
    printf 'the topic home, %s, has no .ai/\n' "$d"
    return 1
  fi
  printf '%s/.ai/topics\n' "$d"
}

# The posts in the topic folder DIR after number N, oldest first
posts_after() {
  ls -1 "$1" 2>/dev/null | awk -F- -v n="$2" '/^[0-9]+-.*\.md$/ && $1 + 0 > n'
}

# A post's number, from its file name
post_number() {
  printf '%s\n' "${1%%-*}" | sed -e 's/^0*//' -e 's/^$/0/'
}

# The topics the project at ROOT follows: mail.follow in its config, a flow
# list on the line (["#a", "#b"]) or a block list below it
follows() {
  [ -f "$1/.ai/config.yml" ] || return 0
  tr -d '\r' <"$1/.ai/config.yml" | awk '
    function clean(v) {
      sub(/^[ \t]+/, "", v)
      if (v ~ /^"/) { v = substr(v, 2); sub(/".*$/, "", v) }
      else if (v ~ /^'\''/) { v = substr(v, 2); sub(/'\''.*$/, "", v) }
      else { sub(/[ \t]+#.*$/, "", v); sub(/[ \t]+$/, "", v) }
      return v
    }
    /^[^ \t#]/ { mail = ($0 ~ /^mail:[ \t]*(#.*)?$/); block = 0; next }
    !mail { next }
    /^[ \t]+follow:/ {
      v = $0; sub(/^[ \t]+follow:[ \t]*/, "", v)
      if (v ~ /^\[/) {
        v = substr(v, 2); sub(/\].*$/, "", v)
        n = split(v, a, ",")
        for (i = 1; i <= n; i++) { x = clean(a[i]); if (x != "") print x }
      } else block = 1
      next
    }
    block && /^[ \t]+-/ { v = $0; sub(/^[ \t]+-[ \t]*/, "", v); x = clean(v); if (x != "") print x; next }
    /^[ \t]+[^ \t#-]/ { block = 0 }'
}

# The project at ROOT's place in TOPIC: the number of the last post it read
place_of() {
  if [ -f "$1/.ai/mail/following" ]; then
    awk -v t="$2" '$1 == t { p = $2 } END { print p + 0 }' "$1/.ai/mail/following"
  else
    printf '0\n'
  fi
}

# Moves the project at ROOT's place in TOPIC to N
set_place() {
  [ -d "$1/.ai/mail" ] || return 0
  tmp=$1/.ai/mail/.following.$$
  {
    [ -f "$1/.ai/mail/following" ] && awk -v t="$2" '$1 != t' "$1/.ai/mail/following"
    printf '%s %s\n' "$2" "$3"
  } >"$tmp" && mv "$tmp" "$1/.ai/mail/following"
}

# Posts the message in $f to the topic folder DIR, taking the next number
# while holding the topic's lock: prints the post's number, or why it
# couldn't post. A post with this id already there (a run that stopped
# before filing it) keeps its number.
post_to() {
  tries=0
  until lock "$1/.posting"; do
    tries=$((tries + 1))
    if [ "$tries" -ge 5 ]; then
      printf 'another post to %s is being made: it goes next time\n' "$to"
      return 1
    fi
    sleep 1
  done
  old=$(ls -1 "$1" | grep -e "^[0-9]*-.*-$id\\.md\$" | head -n 1)
  if [ -n "$old" ]; then
    rmdir "$1/.posting"
    post_number "$old"
    return 0
  fi
  n=$(posts_after "$1" 0 | awk -F- '{ if ($1 + 0 > m) m = $1 + 0 } END { print m + 1 }')
  pname=$(printf '%06d' "$n")-$iname
  tmp=$1/.$pname.$$
  # The shell's own errors (a folder it can't write to) are left unsaid: the
  # line printed says what happened
  if ! { {
    printf 'From: %s\nTo: %s\nSent: %s\n' "$sender" "$to" "$iso"
    [ -n "$topic" ] && printf 'Subject: %s\n' "$topic"
    printf 'Id: %s\nPost: %s\n' "$id" "$n"
    [ -n "$re" ] && printf 'Re: %s\n' "$re"
    printf 'Via: local\n\n'
    tail -n "+$k" "$f"
  } >"$tmp"; } 2>/dev/null || ! mv "$tmp" "$1/$pname" 2>/dev/null; then
    rm -f "$tmp"
    rmdir "$1/.posting"
    printf 'couldn'\''t write to %s\n' "$1"
    return 1
  fi
  rmdir "$1/.posting"
  printf '%s\n' "$n"
}

# -- Messages ------------------------------------------------------------------

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | cut -d ' ' -f 1
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | cut -d ' ' -f 1
  else
    openssl dgst -sha256 | sed 's/^.*[= ]//'
  fi
}

# "H K" for an outbound file: it has H header lines (leading lines starting
# `By: `, `Held: `, `Re: `, `Sent: `, `Id: ` or `Post: `), and its message
# starts on line K, after them and the blank line that ends them.
layout() {
  awk '/^(By|Held|Re|Sent|Id|Post): / { h++; next }
       { b = (h > 0 && $0 == ""); exit }
       END { print h + 0, h + b + 1 }' "$1"
}

# Whether a Re: line names something: a message's id (hex digits, 8 or
# more) or a topic's post (#topic:number)
re_ok() {
  case $1 in
    \#*:*)
      p=${1##*:} t=${1%:*}
      t=${t#\#}
      case $p in '' | *[!0-9]*) return 1 ;; esac
      case $t in '' | *[!a-z0-9.-]*) return 1 ;; esac
      ;;
    *)
      [ ${#1} -ge 8 ] || return 1
      case $1 in *[!0-9a-f]*) return 1 ;; esac
      ;;
  esac
}

# Delivers the outbox of the project at ROOT: one line per message
deliver() {
  root=$1
  box=$root/.ai/mail/outbox
  [ -d "$box" ] || return 0
  names=$(ls -1 "$box" 2>/dev/null)
  [ -n "$names" ] || return 0

  if ! sender=$(handle_of "$root"); then
    printf 'error: %s/.ai/config.yml: its handle line isn'\''t a handle, so nothing was delivered\n' "$root"
    return 0
  fi
  sender=@$sender

  # One delivery per outbox at a time
  if ! lock "$box/.delivering"; then
    printf 'busy: another delivery from this outbox is running\n'
    return 0
  fi
  LOCK=$box/.delivering

  scan "$root"
  printf '%s\n' "$names" | while IFS= read -r name; do
    f=$box/$name
    [ -f "$f" ] || continue
    case $name in
      [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]Z-[@#]*.md) ;;
      *)
        printf 'left in the outbox: %s: its name isn'\''t <time>-<address>--<topic>.md\n' "$name"
        continue
        ;;
    esac
    base=${name#????????-???????-}
    base=${base%.md}
    case $base in
      *--*) to=${base%%--*} topic=${base#*--} ;;
      *) to=$base topic= ;;
    esac
    # Where it goes: a topic's folder, or a project's inbox
    case $to in
      \#*)
        if ! topic_ok "${to#\#}"; then
          printf 'left in the outbox: %s: %s isn'\''t an address\n' "$name" "$to"
          continue
        fi
        if ! dest=$(topic_home "$root"); then
          printf 'left in the outbox: %s: %s\n' "$name" "$dest"
          continue
        fi
        dest=$dest/${to#\#}
        if [ ! -d "$dest" ]; then
          printf 'left in the outbox: %s: there'\''s no topic %s (dot-ai mail topic makes one)\n' "$name" "$to"
          continue
        fi
        ;;
      *)
        case $to in @[a-z]*) bad= ;; *) bad=1 ;; esac
        case ${to#@} in *[!a-z0-9-]*) bad=1 ;; esac
        if [ -n "$bad" ]; then
          printf 'left in the outbox: %s: %s isn'\''t an address\n' "$name" "$to"
          continue
        fi
        if ! dir=$(lookup "$to"); then
          printf 'left in the outbox: %s: %s\n' "$name" "$dir"
          continue
        fi
        dest=$dir/.ai/mail/inbox
        if [ ! -d "$dest" ]; then
          printf 'left in the outbox: %s: %s (%s) has no .ai/mail/inbox/\n' "$name" "$to" "$dir"
          continue
        fi
        ;;
    esac

    set -- $(layout "$f")
    h=$1 k=$2
    re=
    [ "$h" -gt 0 ] && re=$(head -n "$h" "$f" | sed -n 's/^Re: *//p' | head -n 1 | tr -d '\r' | sed 's/[[:space:]]*$//')
    if [ -n "$re" ] && ! re_ok "$re"; then
      printf 'left in the outbox: %s: its Re: line isn'\''t a message'\''s id or a topic'\''s post (#topic:number)\n' "$name"
      continue
    fi
    id=$({
      printf '%s\n%s\n' "$sender" "$name"
      tail -n "+$k" "$f"
    } | sha256 | cut -c 1-8)
    now=$(date -u '+%Y%m%d-%H%M%SZ %Y-%m-%dT%H:%M:%SZ')
    stamp=${now% *} iso=${now#* }

    iname=$stamp-$sender--${topic:+$topic-}$id.md
    post=
    case $to in
      \#*)
        if ! post=$(post_to "$dest"); then
          printf 'left in the outbox: %s: %s\n' "$name" "$post"
          continue
        fi
        ;;
      *)
        # Deliver, unless an earlier run did and stopped before filing it
        seen=
        for x in "$dest/"*"-$id.md" "$dir/.ai/mail/received/"*"-$id.md"; do
          [ -e "$x" ] && seen=1 && break
        done
        if [ -z "$seen" ]; then
          tmp=$dest/.$iname.$$
          if ! { {
            printf 'From: %s\nTo: %s\nSent: %s\n' "$sender" "$to" "$iso"
            [ -n "$topic" ] && printf 'Subject: %s\n' "$topic"
            printf 'Id: %s\n' "$id"
            [ -n "$re" ] && printf 'Re: %s\n' "$re"
            printf 'Via: local\n\n'
            tail -n "+$k" "$f"
          } >"$tmp"; } 2>/dev/null || ! mv "$tmp" "$dest/$iname" 2>/dev/null; then
            rm -f "$tmp"
            printf 'left in the outbox: %s: couldn'\''t write to %s/ (from a sandbox, leave it: the session hooks deliver it when the turn ends)\n' "$name" "$dest"
            continue
          fi
        fi
        ;;
    esac

    # File the original under sent/, with Sent: and Id: lines, and Post: for
    # a post
    sent=$root/.ai/mail/sent
    mkdir -p "$sent"
    if [ ! -e "$sent/$name" ]; then
      tmp=$sent/.$name.$$
      if ! {
        [ "$h" -gt 0 ] && head -n "$h" "$f"
        printf 'Sent: %s via local\nId: %s\n' "$iso" "$id"
        [ -n "$post" ] && printf 'Post: %s\n' "$post"
        printf '\n'
        tail -n "+$k" "$f"
      } >"$tmp" || ! mv "$tmp" "$sent/$name"; then
        rm -f "$tmp"
        printf 'error: %s went to %s, but couldn'\''t be filed under .ai/mail/sent/\n' "$name" "$to"
        continue
      fi
    fi
    rm -f "$f"
    if [ -n "$post" ]; then
      printf 'posted: %s to %s as post %s\n' "$name" "$to" "$post"
    else
      # Its receipt waits until the recipient files it under received/
      grep -q "^$id$TAB" "$box/.receipts" 2>/dev/null ||
        printf '%s\t%s\t%s\t%s\n' "$id" "$to" "$dir" "$name" >>"$box/.receipts"
      printf 'delivered: %s to %s\n' "$name" "$to"
    fi
  done

  rmdir "$LOCK" 2>/dev/null
  LOCK=
}

# The receipts for the mail the project at ROOT sent: each message delivered
# to a project waits in the outbox's .receipts ("id<TAB>address<TAB>its
# project<TAB>name" lines) until its recipient files it under received/.
# Prints a line for each one read, or one that can't be any more, and drops
# it. Left for next time while a delivery holds the outbox.
receipts() {
  box=$1/.ai/mail/outbox
  [ -s "$box/.receipts" ] || return 0
  lock "$box/.delivering" || return 0
  LOCK=$box/.delivering
  tmp=$box/.receipts.$$
  : >"$tmp"
  while IFS=$TAB read -r id to dir name; do
    [ -n "$name" ] || continue
    st=gone
    if [ "${dir#/}" = "$dir" ]; then
      st=waiting # another carrier's, for a recipient elsewhere
    elif [ ! -d "$dir/.ai/mail" ]; then
      st=moved
    else
      for x in "$dir/.ai/mail/received/"*"-$id.md"; do [ -e "$x" ] && st=read && break; done
      if [ "$st" = gone ]; then
        for x in "$dir/.ai/mail/inbox/"*"-$id.md"; do [ -e "$x" ] && st=waiting && break; done
      fi
    fi
    case $st in
      waiting) printf '%s\t%s\t%s\t%s\n' "$id" "$to" "$dir" "$name" >>"$tmp" ;;
      read) printf '  %s read %s\n' "$to" "$name" ;;
      gone) printf '  %s took %s out of its inbox without filing it under received/\n' "$to" "$name" ;;
      moved) printf '  %s: no telling whether it read %s, since its project is no longer at %s\n' "$to" "$name" "$dir" ;;
    esac
  done <"$box/.receipts"
  if [ -s "$tmp" ]; then
    mv "$tmp" "$box/.receipts"
  else
    rm -f "$tmp" "$box/.receipts"
  fi
  rmdir "$LOCK" 2>/dev/null
  LOCK=
}

# The inbox of the project at ROOT, oldest first
inbox_list() {
  [ -d "$1/.ai/mail/inbox" ] && ls -1 "$1/.ai/mail/inbox" 2>/dev/null
}

# -- Commands --------------------------------------------------------------------

cmd_deliver() {
  hand_off deliver "$@"
  root=$(project_root "${1:-.}") || die "no .ai/ at or above ${1:-.}"
  tmpdir
  deliver "$root" >"$TMP/out"
  if [ -s "$TMP/out" ]; then
    cat "$TMP/out"
  else
    printf 'nothing in the outbox\n'
  fi
  ! grep -q -e '^error: ' -e '^left in the outbox: ' "$TMP/out"
}

# A message's topic made into a file name's: lowercase words joined by -
topic_slug() {
  printf '%s\n' "$1" | tr 'A-Z' 'a-z' | tr '\n' ' ' |
    sed -e 's/[^a-z0-9][^a-z0-9]*/-/g' -e 's/^-*//' | cut -c 1-60 | sed 's/-*$//'
}

# One line, for a header
one_line() { printf '%s\n' "$1" | tr '\n\r\t' '   ' | sed -e 's/^ *//' -e 's/ *$//'; }

# Writes a message, MESSAGE on standard input, to the outbox (MODE send)
# or drafts (MODE draft), then delivers what it sent
compose() {
  mode=$1
  shift
  to= topic= re= why= by= dir=.
  while [ $# -gt 0 ]; do
    case $1 in
      --re) re=${2:-} && shift ;;
      --re=*) re=${1#--re=} ;;
      --why | --by | --why=* | --by=*)
        [ "$mode" = draft ] || die "$1 is for a draft: dot-ai mail draft"
        case $1 in
          --why) why=${2:-} && shift ;;
          --why=*) why=${1#--why=} ;;
          --by) by=${2:-} && shift ;;
          --by=*) by=${1#--by=} ;;
        esac
        ;;
      *)
        if [ -z "$to" ]; then
          to=$1
        elif [ -z "$topic" ]; then
          topic=$1
        else
          dir=$1
        fi
        ;;
    esac
    shift
  done
  [ -n "$to" ] && [ -n "$topic" ] || if [ "$mode" = draft ]; then
    die "usage: dot-ai mail draft ADDRESS TOPIC [--re ID] [--why WHY] [--by WHO] [DIR] <MESSAGE"
  else
    die "usage: dot-ai mail send ADDRESS TOPIC [--re ID] [DIR] <MESSAGE, or dot-ai mail send NAME for a draft"
  fi
  case $to in
    \#*) topic_ok "${to#\#}" || die "$to isn't a topic's address" ;;
    *)
      to=@${to#@}
      case ${to#@} in [a-z]*) ;; *) die "$to isn't an address" ;; esac
      case ${to#@} in *[!a-z0-9-]*) die "$to isn't an address" ;; esac
      ;;
  esac
  slug=$(topic_slug "$topic")
  [ -n "$slug" ] || die "TOPIC says what the message is about, in a few words"
  [ -z "$re" ] || re_ok "$re" || die "--re takes the id of the message it answers (its Id: line), or a topic's post (#topic:N)"
  why=$(one_line "$why") by=$(one_line "$by")
  root=$(project_root "$dir") || die "no .ai/ at or above $dir"
  [ ! -t 0 ] || die "the message goes on standard input"
  tmpdir
  cat >"$TMP/msg"
  grep -q '[^[:space:]]' "$TMP/msg" || die "the message is empty"
  [ -z "$(tail -c 1 "$TMP/msg")" ] || printf '\n' >>"$TMP/msg"
  if [ "$mode" = draft ]; then box=$root/.ai/mail/drafts; else box=$root/.ai/mail/outbox; fi
  mkdir -p "$box" || die "couldn't make $box"
  # A name no message of this project's has yet
  tries=0
  while :; do
    name=$(date -u +%Y%m%d-%H%M%SZ)-$to--$slug.md
    [ -e "$root/.ai/mail/drafts/$name" ] || [ -e "$root/.ai/mail/outbox/$name" ] ||
      [ -e "$root/.ai/mail/sent/$name" ] || break
    tries=$((tries + 1))
    [ "$tries" -lt 3 ] || die "couldn't find a name for it in $box"
    sleep 1
  done
  {
    [ -z "$by" ] || printf 'By: %s\n' "$by"
    [ -z "$why" ] || printf 'Held: %s\n' "$why"
    [ -z "$re" ] || printf 'Re: %s\n' "$re"
    [ -z "$by$why$re" ] || printf '\n'
    cat "$TMP/msg"
  } >"$box/.$name" && mv "$box/.$name" "$box/$name" || die "couldn't write $box/$name"
  if [ "$mode" = send ]; then
    cmd_deliver "$root"
  elif [ -n "$by" ]; then
    printf 'drafted: %s, in .ai/mail/drafts/, for the lead to review and send (dot-ai mail send %s)\n' "$name" "$name"
  else
    printf 'drafted: %s, in .ai/mail/drafts/: tell the user; once they approve, dot-ai mail send %s\n' "$name" "$name"
  fi
}

# `send NAME` sends a draft; `send ADDRESS TOPIC ...` a new message
cmd_send() {
  if [ $# -eq 1 ]; then
    case $1 in
      @* | \#* | -*) ;;
      *)
        send_draft "$1"
        return
        ;;
    esac
  fi
  compose send "$@"
}

cmd_draft() { compose draft "$@"; }

# The file ARG names in BOX (inbox or drafts): its path, its name in the
# BOX of the project at or above here, or (in the inbox) the message's id
mail_file() {
  case $2 in
    */*)
      [ -f "$2" ] || return 1
      d=$(cd "$(dirname "$2")" && pwd -P) || return 1
      case $d in */.ai/mail/"$1") printf '%s/%s\n' "$d" "$(basename "$2")" ;; *) return 1 ;; esac
      return 0
      ;;
  esac
  r=$(project_root .) || return 1
  if [ -f "$r/.ai/mail/$1/$2" ]; then
    printf '%s\n' "$r/.ai/mail/$1/$2"
    return 0
  fi
  [ "$1" = inbox ] || return 1
  case $2 in '' | *[!0-9a-f]*) return 1 ;; esac
  m=$(ls -1 "$r/.ai/mail/inbox" 2>/dev/null | grep -e "-$2\.md\$" | head -n 1)
  [ -n "$m" ] && printf '%s\n' "$r/.ai/mail/inbox/$m"
}

# Whether an inbox file is a topic's notice (its sender starts with #)
notice() {
  case ${1#????????-???????-} in \#*) return 0 ;; esac
  return 1
}

# Sends the draft NAME (a name in this project's drafts, or a path): moves
# it to the outbox without its Held: line (a By: line stays: it's the
# record), and delivers
send_draft() {
  f=$(mail_file drafts "$1") ||
    die "no draft $1 in .ai/mail/drafts/ (a new message takes an address and a topic: dot-ai mail send ADDRESS TOPIC)"
  name=$(basename "$f")
  box=$(dirname "$(dirname "$f")")/outbox
  [ ! -e "$box/$name" ] || die "$name is in the outbox already"
  tmpdir
  set -- $(layout "$f")
  head -n "$1" "$f" | grep -v '^Held: ' >"$TMP/head"
  {
    cat "$TMP/head"
    [ ! -s "$TMP/head" ] || printf '\n'
    tail -n "+$2" "$f"
  } >"$box/.$name" && mv "$box/.$name" "$box/$name" && rm -f "$f" ||
    die "couldn't move $name to the outbox"
  cmd_deliver "$(dirname "$(dirname "$(dirname "$box")")")"
}

cmd_done() {
  [ $# -gt 0 ] || die "usage: dot-ai mail done NAME..."
  ok=0
  for a in "$@"; do
    if ! f=$(mail_file inbox "$a"); then
      warn "no message $a in .ai/mail/inbox/"
      ok=1
      continue
    fi
    name=$(basename "$f")
    rec=$(dirname "$(dirname "$f")")/received
    if notice "$name"; then
      rm -f "$f" && printf 'removed: %s: a notice from a topic isn'\''t filed\n' "$name"
    elif [ -e "$rec/$name" ]; then
      rm -f "$f" && printf 'removed: %s: it was filed already\n' "$name"
    elif mkdir -p "$rec" && mv "$f" "$rec/$name"; then
      printf 'filed: .ai/mail/received/%s: commit it with the notes it went into\n' "$name"
    else
      warn "couldn't move $name to $rec/"
      ok=1
    fi
  done
  return $ok
}

cmd_rm() {
  [ $# -gt 0 ] || die "usage: dot-ai mail rm NAME..."
  ok=0
  for a in "$@"; do
    if f=$(mail_file inbox "$a"); then
      name=$(basename "$f")
      if notice "$name"; then
        rm -f "$f" && printf 'removed: %s\n' "$name"
      else
        rm -f "$f" && printf 'removed: %s, not filed: its sender'\''s receipt says so\n' "$name"
      fi
    elif f=$(mail_file drafts "$a"); then
      rm -f "$f" && printf 'removed: %s from .ai/mail/drafts/: never sent\n' "$(basename "$f")"
    else
      warn "no message $a in .ai/mail/inbox/ or .ai/mail/drafts/"
      ok=1
    fi
  done
  return $ok
}

cmd_check() {
  root=$(project_root "${1:-.}") || die "no .ai/ at or above ${1:-.}"
  [ -d "$root/.ai/mail/inbox" ] || die "$root has no .ai/mail/inbox/"
  list=$(inbox_list "$root")
  [ -n "$list" ] || return 1
  printf '%s\n' "$list"
}

cmd_topic() {
  hand_off topic "$@"
  here=$(project_root .) || here=$(pwd -P)
  home=$(topic_home "$here") || die "$home"
  if [ -z "${1:-}" ]; then
    found=
    for d in "$home"/*/; do
      [ -d "$d" ] || continue
      d=${d%/} found=1
      last=$(posts_after "$d" 0 | tail -n 1)
      printf '%-24s %6s posts  %s\n' "#$(basename "$d")" "$(post_number "${last:-0}")" \
        "$(head -n 1 "$d/description" 2>/dev/null)"
    done
    [ -n "$found" ] || printf 'no topics yet (they are kept in %s)\n' "$home"
    return 0
  fi
  t=${1#\#}
  topic_ok "$t" || die "#$t isn't a topic's name: names made like handles, joined by . (#arcana.releases)"
  desc=$(printf '%s' "${2:-}" | tr '\n\r\t' '   ' | sed -e 's/^ *//' -e 's/ *$//')
  [ -n "$desc" ] || die "usage: dot-ai mail topic TOPIC DESCRIPTION (say what the topic is for)"
  [ -d "$home/$t" ] && die "#$t already exists: $(head -n 1 "$home/$t/description" 2>/dev/null)"
  { mkdir -p "$home" && mkdir "$home/$t" && printf '%s\n' "$desc" >"$home/$t/description"; } ||
    die "couldn't make $home/$t"
  printf 'made #%s\n' "$t"
}

cmd_read() {
  hand_off read "$@"
  t= after= dir=.
  while [ $# -gt 0 ]; do
    case $1 in
      --after) after=${2:-} && shift ;;
      --after=*) after=${1#--after=} ;;
      *) if [ -z "$t" ]; then t=$1; else dir=$1; fi ;;
    esac
    shift
  done
  [ -n "$t" ] || die "usage: dot-ai mail read TOPIC [--after N] [DIR]"
  case $after in *[!0-9]*) die "--after takes a post's number" ;; esac
  t=#${t#\#}
  topic_ok "${t#\#}" || die "$t isn't a topic's address"
  root=$(project_root "$dir") || die "no .ai/ at or above $dir"
  home=$(topic_home "$root") || die "$home"
  tdir=$home/${t#\#}
  [ -d "$tdir" ] || die "there's no topic $t"
  place=$(place_of "$root" "$t")
  from=${after:-$place}
  oldest=$(posts_after "$tdir" 0 | head -n 1)
  [ -n "$oldest" ] && oldest=$(post_number "$oldest")
  if [ -n "$oldest" ] && [ "$oldest" -gt $((from + 1)) ]; then
    printf '%s keeps posts from %s on: %s to %s are gone\n\n' "$t" "$oldest" $((from + 1)) $((oldest - 1))
  fi
  posts=$(posts_after "$tdir" "$from")
  if [ -z "$posts" ]; then
    printf 'no posts in %s after %s\n' "$t" "$from"
    return 0
  fi
  printf '%s\n' "$posts" | while IFS= read -r p; do
    printf '==> %s <==\n' "$p"
    cat "$tdir/$p"
    printf '\n'
  done
  last=$(post_number "$(printf '%s\n' "$posts" | tail -n 1)")
  [ "$last" -gt "$place" ] && set_place "$root" "$t" "$last"
  return 0
}

cmd_find() {
  here=$(project_root .) || here=$(pwd -P)
  scan "$here"
  if [ -z "${1:-}" ]; then
    awk -F '\t' '$1 != "!" { printf "%-24s %s\n", $1, $2 }' "$MAP"
    awk -F '\t' '$1 == "!" { print "(can'\''t read the handle) " $2 "/.ai/config.yml" }' "$MAP"
    awk -F '\t' '$1 != "!" { n[$1]++ } END { for (a in n) if (n[a] > 1) print "two projects have the address " a ": nothing is delivered to it" }' "$MAP"
    return 0
  fi
  if dir=$(lookup "@${1#@}"); then
    printf '%s\n' "$dir"
  else
    die "$dir"
  fi
}

# A field of the hook's JSON payload (flat string or boolean fields only)
json_field() {
  printf '%s\n' "$PAYLOAD" | tr '\n' ' ' |
    sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" | head -n 1
}

# stdin as a JSON string
json_str() {
  tr -d '\000-\010\013-\037' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e "s/$TAB/\\\\t/g" |
    awk 'BEGIN { printf "\"" } NR > 1 { printf "%s", "\\n" } { printf "%s", $0 } END { printf "\"" }'
}

count() {
  if [ "$1" -eq 1 ]; then printf '1 %s' "$2"; else printf '%s %ss' "$1" "$2"; fi
}

cmd_hook() {
  event=${1:-}
  shift
  agent=
  while [ $# -gt 0 ]; do
    case $1 in
      --agent) agent=${2:-} && shift ;;
    esac
    shift
  done
  case $event in
    session-start | stop | prompt | session-end) ;;
    *) die "usage: dot-ai hook session-start|stop|prompt|session-end [--agent claude|codex]" ;;
  esac
  # Without --agent (the plugin's hooks): Codex sets PLUGIN_ROOT, Claude Code
  # doesn't; Claude Code sets CLAUDE_PROJECT_DIR (Codex may too)
  if [ -z "$agent" ]; then
    if [ -n "${PLUGIN_ROOT:-}" ]; then
      agent=codex
    elif [ -n "${CLAUDE_PROJECT_DIR:-}" ]; then
      agent=claude
    else
      agent=codex
    fi
  fi
  if [ -t 0 ]; then PAYLOAD=; else PAYLOAD=$(cat); fi
  session=$(json_field session_id | tr -c 'A-Za-z0-9_.-' '_')
  cwd=$(json_field cwd)
  quiet() {
    [ "$agent" = codex ] && case $event in stop | prompt) printf '{}\n' ;; esac
    exit 0
  }
  # Adds what $TMP/say holds to the agent's context, without keeping it going
  context() {
    printf '{"hookSpecificOutput":{"hookEventName":"%s","additionalContext":%s}}\n' \
      "$1" "$(json_str <"$TMP/say")"
    exit 0
  }
  # The receipts, under a line saying what they are
  told_receipts() {
    receipts "$root" >"$TMP/read"
    [ -s "$TMP/read" ] || return 0
    {
      printf 'Receipts for mail this project sent (its copies are in .ai/mail/sent/):\n'
      cat "$TMP/read"
    } >>"$TMP/say"
  }

  root=$(project_root "${CLAUDE_PROJECT_DIR:-${cwd:-.}}") || quiet
  [ -d "$root/.ai/mail" ] || quiet
  [ "$(carrier)" = local ] || quiet
  tmpdir
  : >"$TMP/say"
  # At each prompt, only the receipts: they never keep the agent going on
  # their own, so they wait for the next turn
  if [ "$event" = prompt ]; then
    told_receipts
    [ -s "$TMP/say" ] || quiet
    context UserPromptSubmit
  fi
  deliver "$root" >"$TMP/out"
  [ "$event" = session-end ] && exit 0

  # What this session has been told of, so nothing is announced twice
  rundir=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/dot-ai
  mkdir -p "$rundir" 2>/dev/null && chmod 700 "$rundir" 2>/dev/null
  told=$rundir/${session:-no-session}
  touch "$told" 2>/dev/null || told=$TMP/told
  [ "$event" = session-start ] && find "$rundir" -type f -mtime +7 -exec rm -f {} + 2>/dev/null

  # At session start, everything; at Stop, only what this session hasn't heard
  : >"$TMP/new"
  untold() {
    [ "$event" = session-start ] || ! grep -qxF "$1" "$told"
  }
  sent=$(grep -c -e '^delivered: ' -e '^posted: ' "$TMP/out")
  if [ "$sent" -gt 0 ]; then
    if [ "$sent" -eq 1 ]; then them=it; else them=them; fi
    printf 'dot-ai sent %s from the outbox and filed %s under .ai/mail/sent/: commit %s.\n' \
      "$(count "$sent" message)" "$them" "$them" >>"$TMP/say"
  fi
  grep -e '^error: ' -e '^left in the outbox: ' "$TMP/out" | while IFS= read -r line; do
    untold "out:$line" || continue
    printf 'out:%s\n' "$line" >>"$told"
    printf 'dot-ai: %s\n' "$line" >>"$TMP/say"
  done
  inbox_list "$root" | while IFS= read -r name; do
    untold "in:$name" || continue
    printf 'in:%s\n' "$name" >>"$told"
    printf '  %s\n' "$name" >>"$TMP/new"
  done
  n=$(wc -l <"$TMP/new" | tr -d ' ')
  if [ "$n" -gt 0 ]; then
    if [ "$event" = session-start ]; then what="$(count "$n" message) waiting"; else what=$(count "$n" "new message"); fi
    if [ "$n" -eq 1 ]; then them=it; else them="them, oldest first,"; fi
    {
      printf 'You have mail: %s in .ai/mail/inbox/:\n' "$what"
      cat "$TMP/new"
      printf 'Process %s as the dot-ai skill says (Processing the inbox), filing each with: sh "%s" mail done NAME\n' "$them" "$(self_path)"
    } >>"$TMP/say"
  fi

  # New posts in the topics the project follows, each told of once
  home=$(topic_home "$root") || home=
  : >"$TMP/posts"
  follows "$root" | while IFS= read -r t; do
    why=
    case $t in
      \#*) topic_ok "${t#\#}" || why="$t isn't a topic's address" ;;
      *) why="$t isn't a topic's address" ;;
    esac
    [ -z "$why" ] && [ -z "$home" ] && why="there's no topic $t"
    [ -z "$why" ] && [ ! -d "$home/${t#\#}" ] && why="there's no topic $t"
    if [ -n "$why" ]; then
      untold "follow:$t" || continue
      printf 'follow:%s\n' "$t" >>"$told"
      printf 'dot-ai: mail.follow in .ai/config.yml: %s\n' "$why" >>"$TMP/say"
      continue
    fi
    new=$(posts_after "$home/${t#\#}" "$(place_of "$root" "$t")")
    [ -n "$new" ] || continue
    last=$(post_number "$(printf '%s\n' "$new" | tail -n 1)")
    untold "topic:$t:$last" || continue
    printf 'topic:%s:%s\n' "$t" "$last" >>"$told"
    printf '  %s in %s\n' "$(count "$(printf '%s\n' "$new" | wc -l | tr -d ' ')" "new post")" "$t" >>"$TMP/posts"
  done
  if [ -s "$TMP/posts" ]; then
    {
      printf 'New posts in the topics this project follows:\n'
      cat "$TMP/posts"
      printf 'Read them with: sh "%s" mail read '\''#topic'\'' (the dot-ai skill: Topics).\n' "$(self_path)"
    } >>"$TMP/say"
  fi

  # The receipts too, at session start or when Stop has something to say
  # anyway
  [ "$event" = session-start ] || [ -s "$TMP/say" ] && told_receipts
  if [ ! -s "$TMP/say" ]; then quiet; fi
  [ "$event" = session-start ] && context SessionStart
  if [ "$agent" = codex ]; then
    printf '{"decision":"block","reason":%s}\n' "$(json_str <"$TMP/say")"
    exit 0
  fi
  cat "$TMP/say" >&2 # Claude: exit 2 shows this to the agent and keeps it going
  exit 2
}

cmd_hooks() {
  self=$(command -v dot-ai 2>/dev/null) || self="sh $(self_path)"
  case $self in /*) ;; *) self=$(cd "$(dirname "$self")" && pwd -P)/$(basename "$self") ;; esac
  cat <<EOF
The dot-ai plugin installs these hooks itself. Without it:

Claude Code: merge these into "hooks" in ~/.claude/settings.json

  "SessionStart": [{"hooks": [{"type": "command", "command": "$self hook session-start --agent claude"}]}],
  "Stop": [{"hooks": [{"type": "command", "command": "$self hook stop --agent claude"}]}],
  "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "$self hook prompt --agent claude"}]}],
  "SessionEnd": [{"hooks": [{"type": "command", "command": "$self hook session-end --agent claude"}]}]

Codex: merge these into "hooks" in ~/.codex/hooks.json

  "SessionStart": [{"matcher": "startup|resume|clear", "hooks": [{"type": "command", "command": "$self hook session-start --agent codex", "timeout": 10}]}],
  "Stop": [{"hooks": [{"type": "command", "command": "$self hook stop --agent codex", "timeout": 10}]}],
  "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "$self hook prompt --agent codex", "timeout": 10}]}],
  "SessionEnd": [{"hooks": [{"type": "command", "command": "$self hook session-end --agent codex", "timeout": 10}]}]

Each event's list may already hold other hooks (Arcana's, say): add these
beside them.
EOF
}

cmd_mail() {
  sub=${1:-}
  [ $# -eq 0 ] || shift
  case $sub in
    send) cmd_send "$@" ;;
    draft) cmd_draft "$@" ;;
    check) cmd_check "$@" ;;
    'done') cmd_done "$@" ;;
    rm) cmd_rm "$@" ;;
    deliver) cmd_deliver "$@" ;;
    topic) cmd_topic "$@" ;;
    read) cmd_read "$@" ;;
    find) cmd_find "$@" ;;
    help | -h | --help | '') usage ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

case ${1:-} in
  mail) shift && cmd_mail "$@" ;;
  hook) shift && cmd_hook "$@" ;;
  hooks) cmd_hooks ;;
  version | --version) printf 'dot-ai %s\n' "$VERSION" ;;
  help | -h | --help | '') usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac
