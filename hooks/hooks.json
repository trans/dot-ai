{
  "description": "dot-ai: deliver .ai/mail/outbox to the projects on this machine, and tell the agent when mail is waiting, and when mail it sent has been read",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/dot-ai/scripts/dot-ai\" hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/dot-ai/scripts/dot-ai\" hook stop",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/dot-ai/scripts/dot-ai\" hook prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/dot-ai/scripts/dot-ai\" hook session-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
